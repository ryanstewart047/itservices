# EARPI Website Environment Variables

# Gmail SMTP Configuration for Auto-Notifications (Subscribers, Donors, Contact Form)
# Use your full Gmail address:
GMAIL_USER=official@earpi.org
# Generate an App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASSWORD=your-16-character-app-password
# Admin recipient for notifications:
ADMIN_EMAIL=official@earpi.org

# Optional: AI Chatbot API Key (e.g., Google Gemini or OpenAI)
# If left empty, the chatbot operates in high-quality contextual local mode
GEMINI_API_KEY=
OPENAI_API_KEY=

# Site URL
NEXT_PUBLIC_SITE_URL=https://earpi.org

# Admin Panel Password (protect /admin route)
# Change this to a strong, unique password before deploying to production
ADMIN_PASSWORD=earpi2026!Admin
