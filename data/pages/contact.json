  "title": "Contact Us | EARPI",
  "description": "Contact Us | EARPI - Earth Regenerative Projects International (EARPI)",
  "content": "<!-- Header Section End -->\n\n            <!-- Content Wrapper Start -->\n            <div class=\"content-wrapper\">\n\n                <!-- Breadcrumb Start -->\n                <div class=\"breadcrumb-wrap bg-f br-1\">\n                    <div class=\"container\">\n                        <div class=\"breadcrumb-title\">\n                            <h2>Contact Us</h2>\n                            <ul class=\"breadcrumb-menu list-style\">\n                                <li><a href=\"/\">Home </a></li>\n                                <li>Contact Us</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n                <!-- Breadcrumb End -->\n\n                 <!-- Contact Us section Start -->\n                 <section class=\"contact-us-wrap ptb-100\">\n                    <div class=\"container\">\n                        <div class=\"section-title style1 text-center mb-40\">\n                            <span>Contact Us<img src=\"/assets/img/section-shape.png\" alt=\"Image\"></span>\n                            <h2>Get In Touch With Us</h2>\n                        </div>\n                        <div class=\"row gx-5 justify-content-center\">\n                            <div class=\"col-lg-8\">\n                    <div class=\"contact-form\">\n                    <form class=\"custom-form\" id=\"customContactForm\" action=\"message.php\" method=\"POST\">\n                    <div class=\"row\">\n                        <div class=\"col-md-6 col-sm-6\">\n                            <div class=\"form-group\">\n                                <input type=\"text\" name=\"custom_name\" placeholder=\"Full Name*\" id=\"custom_name\" required data-error=\"Please enter your full name\">\n                                <div class=\"help-block with-errors\"></div>\n                            </div>\n                        </div>\n                        <div class=\"col-md-6 col-sm-6\">\n                            <div class=\"form-group\">\n                                <input type=\"email\" name=\"custom_email\" id=\"custom_email\" required placeholder=\"Email*\" data-error=\"Please enter your email\">\n                                <div class=\"help-block with-errors\"></div>\n                            </div>\n                        </div>\n                        <div class=\"col-md-6 col-sm-6\">\n                            <div class=\"form-group\">\n                                <input type=\"text\" name=\"phone\" id=\"phone\" required placeholder=\"Phone*\" data-error=\"Please enter your phone\">\n                                <div class=\"help-block with-errors\"></div>\n                            </div>\n                        </div>\n                        <div class=\"col-md-6 col-sm-6\">\n                            <div class=\"form-group\">\n                                <input type=\"text\" name=\"msg_subject\" placeholder=\"Subject*\" id=\"msg_subject\" required data-error=\"Please enter your subject\">\n                                <div class=\"help-block with-errors\"></div>\n                            </div>\n                        </div>\n                            <div class=\"col-md-12\">\n                    <div class=\"form-group v1\">\n                        \n                        <textarea id=\"message\" style=\" width: 100%; padding: 10px; font-size: 14px;\" name=\"message\" placeholder=\"Enter any additional message\" oninput=\"limitTextarea(this, 250);\"></textarea>\n                        <span id=\"char-count\">250 characters remaining</span>\n                    </div>\n                     </div>\n                        <div class=\"col-12\"><br>\n                            <div class=\"form-group\">\n                                <input type=\"checkbox\" id=\"privacy-checkbox\" required>\n                                <label for=\"privacy-checkbox\">I have read and agree to the <a href=\"/privacy-policy\" style=\"color: #338F7A; font-weight: bold;\">Privacy Policy</a>.</label>\n                            </div><br>\n                            <button type=\"submit\" class=\"custom-btn style1 w-100 d-block\">Send Custom Message</button>\n                            <div id=\"customMsgSubmit\" class=\"h3 text-center hidden\"></div>\n                            <div class=\"clearfix\"></div>\n                        </div>\n                    </div>\n                    </form>\n                \n                    </div>\n                    </div>\n\n                            <div class=\"col-lg-4\">\n                                <div class=\"contact-item-wrap\">\n                                    <div class=\"contact-item\">\n                                        <h3>Our Address</h3>\n                                        <p>32 Wallace Johnson Street Freetown, Sierra Leone</p>\n                                    </div>\n                                    <div class=\"contact-item\">\n                                        <h3>Email Address</h3>\n                                        <a href=\"mailto:info@itservicesfreetown.com\"><span class=\"__cf_email__\" data-cfemail=\"d2bbbcb4bd92b1bebbbffcb1bdbf\"><strong style=\"font-size: 25px;\">:</strong> earthregenerativeprojectsl@gmail.com</span></a>\n                                        <a href=\"mailto:info@itservicesfreetown.com\"><span class=\"__cf_email__\" data-cfemail=\"mailto:support@itservicesfreetown.com\"><strong style=\"font-size: 25px;\">:</strong> official@earpi.org</span></a>\n                                    </div>\n                                    <div class=\"contact-item\">\n                                        <h3>24/7 Support</h3>\n                                        <a href=\"tel:+12024386441\">+1 (202) 438-6441</a>\n                                      <!--  <a href=\"tel:tel:+971525913753\">+1-619-626-4266</a>-->\n                                    </div>\n                                    <div class=\"contact-item\">\n                                        <h3>Follow us</h3>\n                                        <ul class=\"social-profile style2 list-style\">\n                                            <li>\n                                                <a href=\"https://facebook.com/itservicefreetown\" target=\"_blank\">\n                                                    <i class=\"ri-facebook-fill\"></i>\n                                                </a>\n                                            </li>\n                                            <li>\n                                               <a href=\"https://twitter.com/\" target=\"_blank\">\n                                                    <i class=\"ri-twitter-fill\"></i>\n                                                </a>\n                                            </li>\n                                            <li>\n                                               <a href=\"https://www.linkedin.com/in/ryan-josiah-stewart-19808a152/\" target=\"_blank\">\n                                                    <i class=\"ri-linkedin-fill\"></i>\n                                                </a>\n                                            </li>\n                                            <li>\n                                                <a href=\"https://www.tiktok.com/@itservicesfreetown\" target=\"_blank\">\n                                                    <i class=\"fab fa-tiktok\"></i>\n                                                 </a>\n                                             </li>\n                                        </ul>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <!-- Contact Us section End -->\n\n            </div>\n            <!-- Content wrapper end -->\n\n            <!-- Footer Section Start -->"
}